# Copy to .env and fill in. Paper mode needs nothing.

# paper (default) | live
TRADING_MODE=paper

# Required for live. Bot will refuse to start without this.
CONFIRM_LIVE=YES

# Keep true until you have verified on Binance futures testnet.
BINANCE_TESTNET=true

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Dashboard mutation password (8+ chars). Required in live mode.
CONTROL_TOKEN=change-me-now

# 1–5. Default 1x — do not raise until the bot is proven.
FUTURES_LEVERAGE=1

# Halt and flatten if realized daily loss exceeds this percent of start-of-day equity.
MAX_DAILY_LOSS_PERCENT=5
