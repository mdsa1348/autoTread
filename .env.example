# Copy to .env and fill in. Paper mode needs nothing.

# ── Trading mode ───────────────────────────────────────────────────────────────
# paper (default) | live
TRADING_MODE=paper

# Required for live. Bot will refuse to start without this.
CONFIRM_LIVE=YES

# Keep true until you have verified on Binance futures testnet.
BINANCE_TESTNET=true

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Dashboard mutation password (8+ chars). Required in live mode.
CONTROL_TOKEN=change-me-now

# 1–5. Default 1x — do not raise until the bot is proven.
FUTURES_LEVERAGE=1

# Optional: HTTP sidecar for a third-party second-opinion model (JSON).
# SECOND_OPINION_URL=

# Context APIs (funding / long-short / Fear&Greed) need no keys — public endpoints.

# ── Multi-Exchange via CCXT ────────────────────────────────────────────────────
# EXCHANGE_ID — ccxt exchange id. Default: binance.
#   Options: okx | bybit | kucoin | gate | mexc | bitget | ... (any ccxt exchange)
#   When set to binance (default), the native Binance WebSocket stack is used.
#   Any other exchange uses ccxt REST klines with the same candle format.
# EXCHANGE_ID=binance

# EXCHANGE_API_KEY / EXCHANGE_SECRET — for non-Binance exchanges (optional for data).
# EXCHANGE_API_KEY=
# EXCHANGE_SECRET=

# EXCHANGE_SANDBOX — set true to use testnet/sandbox on supported exchanges.
# EXCHANGE_SANDBOX=false

# ── News Feed ─────────────────────────────────────────────────────────────────
# GITHUB_TOKEN — optional. GitHub API is 60 req/hr unauthenticated, 5000 with token.
# GITHUB_TOKEN=

# ── Storage paths ──────────────────────────────────────────────────────────────
# DATA_DIR       — small/fast state files (data_store.json, neural net models).
#                  Defaults to the project folder (C:\xampp\htdocs\AutoTread).
#                  In Docker this is usually /data (mounted volume).
# DATA_DIR=D:\AutoTread_data

# LARGE_DATA_DIR — large ever-growing files (minute_analysis.json, archive/).
#                  Defaults to D:\AutoTread_data on Windows (keeps C drive lean),
#                  or falls back to DATA_DIR if D:\ doesn't exist.
# LARGE_DATA_DIR=D:\AutoTread_data

# ── Harness CI/CD secrets (set in Harness secret manager, not here) ────────────
# fly_api_token  — Fly.io deploy token (set as Harness secret)
# dockerhub_connector — Docker Hub connector configured in Harness UI
